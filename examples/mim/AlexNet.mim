// REQUIRES: release
// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=GONE

// AlexNet forward pass (batch 10, 3x224x224 -> 1000 logits), rewritten in surface syntax from a PyTorch graph
// dump: five convolutions (11x11/stride4, 5x5, 3x3, 3x3, 3x3), each followed by bias + ReLU, with 3x3/stride-2
// max-pools after the 1st, 2nd, and 5th conv, then flatten and three fully-connected layers. Conv biases are
// broadcast NCHW-style via %tensor.reshape + %tensor.broadcast, FC biases tiled via %tensor.reshape +
// %tensor.repeat, exactly as the importer emits them. Dropout is the identity at inference and so is elided.
// Lowered through the DEFAULT pipeline on the Mim IR level (no codegen), checking that no %tensor /
// map_reduce / %affine residue remains.
// CHECK: extern alexnet
// GONE-NOT: %tensor.
// GONE-NOT: map_reduce
// GONE-NOT: %affine.

plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin math;

let f32 = %math.f32;
let F32 = %math.F32;

let R: %tensor.Ring = (F32, 0:F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

let add     = %math.arith.add @f32 0;
let fmax    = %math.extrema.fmax @f32 0;
let neg_inf = 0xFF800000:F32;

lam relu (x: F32): F32 = fmax (0:F32, x);

// Conv parameter triples are (stride, dilation, padding).
let conv1 = ((4, 4), (1, 1), (2, 2)); // 11x11, stride 4, pad 2
let conv2 = ((1, 1), (1, 1), (2, 2)); // 5x5, stride 1, pad 2
let same  = ((1, 1), (1, 1), (1, 1)); // 3x3, stride 1, pad 1 -- keeps spatial size

// Per-channel bias + ReLU after a convolution: `bias` is reshaped to rank 4 and broadcast over NCHW.
lam conv_epilogue (n c h w: Nat) (t: «n, c, h, w; F32», bias: «c; F32»): «n, c, h, w; F32» =
    let bias4 = %tensor.broadcast ((1, c, 1, 1), (n, c, h, w), %tensor.reshape c (1, c, 1, 1) bias);
    %tensor.unary relu @(4, (n, c, h, w)) (%tensor.binary add @(4, (n, c, h, w)) (t, bias4));

// x·Wᵀ + b for a linear layer with the weight stored PyTorch-style as «c_out, c_in; F32».
lam linear (n c_in c_out: Nat) (x: «n, c_in; F32», w: «c_out, c_in; F32», bias: «c_out; F32»): «n, c_out; F32» =
    let z  = %tensor.product_2d R (x, %tensor.transpose_2d w);
    let b2 = %tensor.repeat (1, c_out) (n, c_out) (%tensor.reshape c_out (1, c_out) bias);
    %tensor.binary add @(2, (n, c_out)) (z, b2);

// Parameters follow torchvision's alexnet: w<i>/b<i> is features.<i>.{weight,bias}, fc<i>_* is classifier.<i>.*.
fun extern alexnet
    (x: «10, 3, 224, 224; F32»,
     w0:  «64, 3, 11, 11; F32»,    b0:  «64; F32»,
     w3:  «192, 64, 5, 5; F32»,    b3:  «192; F32»,
     w6:  «384, 192, 3, 3; F32»,   b6:  «384; F32»,
     w8:  «256, 384, 3, 3; F32»,   b8:  «256; F32»,
     w10: «256, 256, 3, 3; F32»,   b10: «256; F32»,
     fc1_w: «4096, 9216; F32»,     fc1_b: «4096; F32»,
     fc4_w: «4096, 4096; F32»,     fc4_b: «4096; F32»,
     fc6_w: «1000, 4096; F32»,     fc6_b: «1000; F32»)
    : «10, 1000; F32» =
    // Conv 1: 3 -> 64, 11x11/stride4/pad2, 224 -> 55; pool 3x3/stride2, 55 -> 27.
    let a = conv_epilogue (10, 64, 55, 55) (%tensor.conv R conv1 (x, w0), b0);
    let a = %tensor.pool (fmax, neg_inf) ((3, 3), (2, 2), (1, 1), (0, 0), (27, 27)) a;
    // Conv 2: 64 -> 192, 5x5/pad2, 27 -> 27; pool 3x3/stride2, 27 -> 13.
    let a = conv_epilogue (10, 192, 27, 27) (%tensor.conv R conv2 (a, w3), b3);
    let a = %tensor.pool (fmax, neg_inf) ((3, 3), (2, 2), (1, 1), (0, 0), (13, 13)) a;
    // Conv 3, 4, 5: 192 -> 384 -> 256 -> 256, 3x3/pad1, size stays 13; pool 3x3/stride2, 13 -> 6.
    let a = conv_epilogue (10, 384, 13, 13) (%tensor.conv R same (a, w6), b6);
    let a = conv_epilogue (10, 256, 13, 13) (%tensor.conv R same (a, w8), b8);
    let a = conv_epilogue (10, 256, 13, 13) (%tensor.conv R same (a, w10), b10);
    let a = %tensor.pool (fmax, neg_inf) ((3, 3), (2, 2), (1, 1), (0, 0), (6, 6)) a;
    // AdaptiveAvgPool2d((6,6)) is the identity here since the input is already 6x6, so it's elided.
    // Classifier: flatten, then 9216 -> 4096 -> 4096 -> 1000 (ReLU in between, none after the last layer;
    // dropout is the identity at inference).
    let a = %tensor.reshape (10, 256, 6, 6) (10, 9216) a;
    let a = %tensor.unary relu @(2, (10, 4096)) (linear (10, 9216, 4096) (a, fc1_w, fc1_b));
    let a = %tensor.unary relu @(2, (10, 4096)) (linear (10, 4096, 4096) (a, fc4_w, fc4_b));
    return (linear (10, 4096, 1000) (a, fc6_w, fc6_b));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );
